OIDC_ISSUER_URL="https://auth.company.com"
OIDC_CLIENT_ID="your-client-id"
OIDC_CLIENT_SECRET="your-client-secret" # optional for public OIDC clients that don't require any such
OIDC_SCOPES="openid profile"
OIDC_REDIRECT_URL="http://localhost:8080/auth/callback"
UPSTREAM_MCP_URL="https://mcp-upstream.company.com/mcp"

# Web mode: send the upstream no credential at all -- not even the user's
# token -- for an upstream that validates none (default: forward).
# OUTBOUND_AUTH="none"

# Web mode only: several upstreams behind one sign-in, each served at
# /<name>/mcp. Use instead of UPSTREAM_MCP_URL; every UPSTREAM_<NAME>_*
# setting below is optional and falls back to its global counterpart.
# UPSTREAMS="secure,emb3d"
# UPSTREAM_SECURE_MCP_URL="https://secure-upstream.company.com/mcp"
# UPSTREAM_EMB3D_MCP_URL="https://emb3d-upstream.company.com/mcp"
# UPSTREAM_EMB3D_OUTBOUND_AUTH="none" # no credential sent to this upstream
# UPSTREAM_EMB3D_PROXY_NAME="MITRE EMB3D"
# DEFAULT_UPSTREAM="secure" # also served at /mcp for existing clients
